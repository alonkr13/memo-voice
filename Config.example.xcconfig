// Copy to Config.xcconfig (gitignored) and fill in your iOS OAuth client from Google Cloud Console.
// GOOGLE_CLIENT_ID is "<prefix>.apps.googleusercontent.com"; the reversed ID is
// "com.googleusercontent.apps.<prefix>". The placeholders below build but cannot sign in.
GOOGLE_CLIENT_ID = placeholder.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder
